# Supabase (https://supabase.com/dashboard)
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# App URL (invite links + confirmation emails) — use mode-specific files instead:
#   .env.development  → http://localhost:3000  (npm run dev)
#   .env.production   → https://your-app.onrender.com  (npm run build / deploy)
# Optional override in .env for all modes:
# NUXT_PUBLIC_SITE_URL=http://localhost:3000

# AI resume parsing
# AI_PROVIDER can be gemini or claude. Leave blank to prefer Gemini when configured,
# then Claude when only ANTHROPIC_API_KEY is configured.
# AI_PROVIDER=claude
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Parse rate limit (optional — defaults: 8 requests per 15 minutes per invite token)
# PARSE_RATE_LIMIT_MAX=8
# PARSE_RATE_LIMIT_WINDOW_MS=900000

# Admin parse QA panel — superseded by PLATFORM_ADMIN_EMAILS + Dev tools toggle
# ENABLE_PARSE_AUDIT_UI=true

# Platform admin emails (comma-separated) — Dev tools toggle in Admin menu
# (Show all recruiters, Parse QA, parse fixtures). Example: juan@juanrod.dev
# PLATFORM_ADMIN_EMAILS=you@example.com

# Resend (confirmation emails) — https://resend.com
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=onboarding@resend.dev
